# ViaFast backend — environment template.
# Copy to .env and adjust for your machine. Never commit real secrets.

# Node runtime environment: development | test | production
NODE_ENV=development

# HTTP port the API listens on (frontend dev server runs on 3000)
PORT=3001

# PostgreSQL connection string (matches backend/docker-compose.yml defaults).
# In production, replace host/user/password with managed-database values
# from your secret manager — never hardcode production credentials here.
DATABASE_URL=postgresql://viafast:viafast@localhost:5432/viafast?schema=public

# Comma-separated browser origins allowed by CORS.
# Leave unset or empty in development to allow all origins.
CORS_ORIGINS=http://localhost:3000

# Docker Compose PostgreSQL settings (used only by docker-compose.yml)
POSTGRES_USER=viafast
POSTGRES_PASSWORD=viafast
POSTGRES_DB=viafast
POSTGRES_PORT=5432
