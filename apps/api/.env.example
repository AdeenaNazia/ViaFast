# ─────────────────────────────────────────────────────────────────────────────
# ViaFast API — environment template.  Copy to `.env` and fill in LOCAL values.
#   cp .env.example .env
# `.env` is git-ignored. NEVER commit real credentials or secrets.
# Prisma 7 does NOT auto-load .env; ./prisma7.config.ts and ./src/config/env.ts
# both `import "dotenv/config"`.
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ────────────────────────────────────────────────────────────────
# development | test | production
NODE_ENV="development"
# Interface to bind. 127.0.0.1 is least-privilege for local dev; set explicitly
# (and put the process behind a TLS proxy) for any real deployment.
HOST="127.0.0.1"
PORT="8080"
LOG_LEVEL="info"

# ── Database (DEVELOPMENT only — never point this at production) ─────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/viafast_dev?schema=public"

# ── Auth / tokens ──────────────────────────────────────────────────────────────
# HS256 signing key. MUST be a cryptographically random string >= 32 chars.
# In production this is REQUIRED and the server refuses to boot without it.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Leave UNSET in local dev to auto-generate an EPHEMERAL secret (tokens then do
# not survive a restart). Never reuse a value across environments.
# ACCESS_TOKEN_SECRET=""

# Access-token lifetime (short-lived). Allowed units: s|m|h|d. Range: 60s..1h.
ACCESS_TOKEN_TTL="15m"
# Rotating refresh-token lifetime. Must exceed ACCESS_TOKEN_TTL; max 90d.
REFRESH_TOKEN_TTL="30d"
# JWT issuer / audience (validated on every request).
TOKEN_ISSUER="viafast-api"
TOKEN_AUDIENCE="viafast-clients"

# ── CORS (explicit allowlist; comma-separated; NO '*' with credentials) ────────
# In production at least one explicit origin is REQUIRED.
CORS_ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000"

# ── Proxy trust (conservative). Only enable behind a known reverse proxy. ──────
TRUST_PROXY="false"

# ── Auth rate limiting (login/refresh). Lower max = stricter. ──────────────────
# A separate coarse global limiter (300/min) also applies to all other routes.
AUTH_RATE_LIMIT_MAX="10"
AUTH_RATE_LIMIT_WINDOW="5m"

# ── Data lifecycle ──────────────────────────────────────────────────────────────
# Proposed raw-GPS retention window in days (ADR-021).
# NOTE: 90 days is a PROPOSAL pending university approval — NOT a confirmed legal
# or university retention policy. Change via config, not code.
LOCATION_RETENTION_DAYS="90"

# ── Development fixtures (local only — ignored by the API at runtime) ───────────
# Password for the SYNTHETIC development Student created by
#   npm run provision:dev-student
# Login as `dev.student@viafast.test` with this password (8..128 chars).
# Deliberately NOT a CLI argument (shell history) and NOT prompted (so no default
# can ever be baked into the repo). Only an Argon2id hash is stored; the value
# below is never persisted, returned, or logged. Choose your own — do not reuse
# any real password, and never set this in a production environment: the
# provisioning tool refuses to run unless NODE_ENV != production AND DATABASE_URL
# names a dev/test/local database.
# VIAFAST_DEV_STUDENT_PASSWORD=""
